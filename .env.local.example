# ---------------------------------------------------------------------------
# Flamme Rouge — copie este arquivo para `.env.local` e preencha.
# `.env.local` está no .gitignore e nunca vai para o repositório.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API → Project API keys → anon / publishable
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase → Project Settings → API → Project API keys → service_role (SECRETO)
# Usado apenas em Route Handlers do servidor, nunca exposto ao browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Supabase → Project Settings → Database → Connection string → URI
# Troque [YOUR-PASSWORD] pela senha real do banco. Usado só pelo script de
# migração (`npm run db:migrate`), não pela aplicação em runtime.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:SENHA@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# URL base da aplicação — usada pelo simulador e pelos testes e2e.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Aviso por e-mail do formulário de contato da landing
# ---------------------------------------------------------------------------
# As três juntas ligam o aviso. Faltando qualquer uma, o pedido continua sendo
# gravado em `contact_requests` normalmente — só não chega e-mail, e o log do
# servidor diz por quê. Nunca derruba o formulário.
#
# A chave sai de https://resend.com → API Keys. O plano gratuito cobre folgado
# o volume de uma caixa de contato.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Para onde o aviso vai. É a sua caixa.
CONTACT_NOTIFY_TO=cristiano@zeroventuno.com

# De onde ele sai. Enquanto o domínio não estiver verificado no Resend, use o
# remetente de teste deles — funciona na hora e chega. Depois de verificar
# flammerouge.org lá (o Resend dá os registros de DNS para colar na Hostinger),
# troque por algo como "Flamme Rouge <contato@flammerouge.org>", que é o que
# não cai em spam e o que o destinatário reconhece.
CONTACT_NOTIFY_FROM=Flamme Rouge <onboarding@resend.dev>
